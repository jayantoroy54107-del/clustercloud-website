# =============================================================================
# ClusterCloud — environment variables
# Copy this file to ".env" and fill in the real values.  NEVER commit ".env".
# =============================================================================

# Web3Forms access key — powers the contact form on /contact.
# Get a FREE key in ~30 seconds:
#   1. Go to https://web3forms.com
#   2. Enter the email that should RECEIVE the messages:  info@clustercloud.org
#   3. Check that inbox for a confirmation / the access key
#   4. Paste the key below
#
# In Vite, only variables prefixed with "VITE_" are exposed to the browser —
# this is fine here because Web3Forms access keys are PUBLIC by design
# (they are meant to be used in client-side HTML/JS).
VITE_WEB3FORMS_ACCESS_KEY=your-access-key-here
